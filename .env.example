# Database connection string (automatically set by Railway when adding PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/hammerhouse_db?schema=public"

# GoHighLevel Inbound Webhook URL (Paste your GHL workflow inbound webhook here)
GHL_WEBHOOK_URL="https://services.leadconnectorhq.com/hooks/your_inbound_webhook_id"

# Optional: Environment
NODE_ENV="development"
